HOST=127.0.0.1
PORT=3000
# Required when listening outside loopback (at least 24 characters).
API_TOKEN=
# Comma-separated browser origins of your own client app (this repo ships no frontend).
# Empty allows non-browser clients only.
CORS_ORIGINS=
PERSIST_COOKIE=true
COOKIE_FILE=./data/netease.cookie
UPSTREAM_TIMEOUT_MS=8000
PLAYBACK_BUDGET_MS=15000
PROBE_AUDIO=true
# Random key generated per process when empty; existing tickets then expire on restart.
MEDIA_SECRET=
MEDIA_TTL_SECONDS=300
RATE_LIMIT_PER_MINUTE=120
MEDIA_RATE_LIMIT_PER_MINUTE=600
LOG_REQUESTS=true
